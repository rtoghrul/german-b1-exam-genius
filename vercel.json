{
  "rewrites": [
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/vocab", "destination": "/index.html" },
    { "source": "/lesen", "destination": "/index.html" },
    { "source": "/hoeren", "destination": "/index.html" },
    { "source": "/schreiben", "destination": "/index.html" },
    { "source": "/sprechen", "destination": "/index.html" },
    { "source": "/grammatik", "destination": "/index.html" },
    { "source": "/ressourcen", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
